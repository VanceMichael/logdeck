+func TestRetryReadOnlyCleanup(t *testing.T) {
+	router, _, supervisor := newBoundaryRouter(t, "")
+
+	if w := putReadOnly(t, router, "true"); w.Code != http.StatusOK {
+		t.Fatalf("enable = %d: %s", w.Code, w.Body.String())
+	}
